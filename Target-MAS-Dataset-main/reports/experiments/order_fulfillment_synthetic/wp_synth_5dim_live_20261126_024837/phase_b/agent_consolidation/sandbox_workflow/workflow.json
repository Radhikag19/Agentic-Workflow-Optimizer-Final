{
  "workflow_name": "order_fulfillment_synthetic",
  "version": "1.0.0",
  "description": "Synthetic 7-agent CrewAI order fulfillment workflow engineered to exercise all 5 optimization dimensions (Data Handoff, Consolidation, Model Selection, Parallelization, Prompt Optimization).",
  "framework": "crewai",
  "fixed_model": "openai/gpt-oss-120b",
  "baseline_model": "openai/gpt-oss-120b",
  "assigned_groq_key_env": "GROQ_API_KEY_14",
  "llm_provider": "Groq",
  "total_agents": 6,
  "agent_count": 6,
  "execution_pattern": "sequential",
  "execution_order": [
    "order_intake_agent",
    "inventory_check_agent",
    "fraud_screen_agent",
    "consolidated_carrier_routing_tax_classify",
    "invoice_tag_agent",
    "fulfillment_summary_agent"
  ],
  "agents": [
    {
      "agent_id": "order_intake_agent",
      "agent_name": "Order Intake Agent",
      "role": "Order Intake Coordinator",
      "responsibilities": "Extract and normalize incoming synthetic order payloads into structured customer, SKU, shipping, and legacy metadata fields.",
      "input_fields": [
        "record_id",
        "customer_id",
        "customer_tier",
        "billing_country",
        "shipping_region",
        "warehouse_region",
        "shipping_speed",
        "order_total_usd",
        "sku_items"
      ],
      "output_fields": [
        "record_id",
        "request_id",
        "customer_id",
        "customer_tier",
        "billing_country",
        "shipping_region",
        "warehouse_region",
        "order_total_usd",
        "shipping_speed",
        "sku_items",
        "legacy_erp_dump",
        "raw_audit_trail",
        "debug_headers",
        "deprecated_sku_notes",
        "internal_routing_flags",
        "formatting_metadata"
      ],
      "dependencies": []
    },
    {
      "agent_id": "inventory_check_agent",
      "agent_name": "Inventory Check Agent",
      "role": "Warehouse Inventory Specialist",
      "responsibilities": "Check SKU stock availability and warehouse code from intake order quantities.",
      "input_fields": [
        "sku_items",
        "warehouse_region"
      ],
      "output_fields": [
        "in_stock",
        "warehouse_code",
        "backorder_skus",
        "inventory_note"
      ],
      "dependencies": [
        "order_intake_agent"
      ]
    },
    {
      "agent_id": "fraud_screen_agent",
      "agent_name": "Fraud Screen Agent",
      "role": "Order Risk Screener",
      "responsibilities": "Screen customer tier, country, and order total for risk band and review flag.",
      "input_fields": [
        "customer_id",
        "customer_tier",
        "order_total_usd",
        "billing_country"
      ],
      "output_fields": [
        "risk_band",
        "review_flag",
        "screen_note"
      ],
      "dependencies": [
        "order_intake_agent"
      ]
    },
    {
      "agent_id": "consolidated_carrier_routing_tax_classify",
      "agent_name": "Consolidated carrier_routing_agent..tax_classify_agent",
      "role": "Deterministically assign carrier routing details and compute regional tax information while preserving inventory and fraud flags.",
      "responsibilities": "Map shipping_region and shipping_speed to carrier_name, service_level, and estimated_days while forwarding in_stock and review_flag. Compute tax_jurisdiction, tax_rate_pct, and tax_amount_usd from billing_country and order_total_usd while forwarding carrier and flag fields.",
      "goal": "For each record, determine carrier_name, service_level, estimated_days, tax_jurisdiction, tax_rate_pct, and tax_amount_usd, and forward in_stock, review_flag, carrier_name, and service_level unchanged.",
      "unified_prompt": "You are given the following inputs for each order record: shipping_region, shipping_speed, warehouse_code, in_stock, risk_band, review_flag, billing_country, order_total_usd, and record_id.\n\nStep 1 \u2013 Carrier Routing:\n- Determine carrier_name:\n  * 'UPS' if shipping_region starts with 'US' or 'CA'.\n  * 'DHL' if shipping_region starts with 'EU' or 'UK'.\n  * Otherwise 'FedEx'.\n- Determine service_level and estimated_days based on shipping_speed:\n  * 'standard' \u2192 service_level='Standard', estimated_days=5\n  * 'expedited' \u2192 service_level='Expedited', estimated_days=2\n  * 'overnight' \u2192 service_level='Overnight', estimated_days=1\n- Forward the boolean values in_stock and review_flag unchanged.\n\nStep 2 \u2013 Tax Classification:\n- Compute tax_jurisdiction as \"{billing_country}-TAX\".\n- Look up tax_rate_pct using the table:\n  US=8.0, CA=13.0, DE=19.0, UK=20.0, JP=10.0, all other countries=5.0.\n- Calculate tax_amount_usd = round(order_total_usd * tax_rate_pct / 100.0, 2).\n- Forward in_stock, review_flag, carrier_name, and service_level unchanged.\n\nFinal Output:\nReturn ONLY a JSON object with the exact fields:\n{\n  \"record_id\": \"<record_id>\",\n  \"carrier_name\": \"UPS|DHL|FedEx\",\n  \"service_level\": \"Standard|Expedited|Overnight\",\n  \"estimated_days\": <1|2|5>,\n  \"in_stock\": <true|false>,\n  \"review_flag\": <true|false>,\n  \"tax_jurisdiction\": \"<billing_country>-TAX\",\n  \"tax_rate_pct\": <numeric>,\n  \"tax_amount_usd\": <numeric>\n}\nAll numeric values must be represented as numbers (no quotes). Ensure the JSON is syntactically valid and contains no additional fields.",
      "consolidated_from": [
        "carrier_routing_agent",
        "tax_classify_agent"
      ],
      "input_fields": [
        "shipping_region",
        "shipping_speed",
        "warehouse_code",
        "in_stock",
        "risk_band",
        "review_flag",
        "billing_country",
        "order_total_usd",
        "carrier_name",
        "service_level"
      ],
      "output_fields": [
        "tax_jurisdiction",
        "tax_rate_pct",
        "tax_amount_usd",
        "in_stock",
        "review_flag",
        "carrier_name",
        "service_level"
      ],
      "dependencies": [
        "inventory_check_agent",
        "fraud_screen_agent"
      ],
      "model": "openai/gpt-oss-120b"
    },
    {
      "agent_id": "invoice_tag_agent",
      "agent_name": "Invoice Tag Agent",
      "role": "Ledger Invoice Tagger",
      "responsibilities": "Compute gl_account_code, invoice_tag, and billing_batch while forwarding in_stock, review_flag, carrier, and tax fields.",
      "input_fields": [
        "customer_tier",
        "tax_jurisdiction",
        "tax_amount_usd",
        "in_stock",
        "review_flag",
        "carrier_name",
        "service_level"
      ],
      "output_fields": [
        "gl_account_code",
        "invoice_tag",
        "billing_batch",
        "in_stock",
        "review_flag",
        "carrier_name",
        "service_level",
        "tax_jurisdiction",
        "tax_amount_usd"
      ],
      "dependencies": [
        "consolidated_carrier_routing_tax_classify"
      ]
    },
    {
      "agent_id": "fulfillment_summary_agent",
      "agent_name": "Fulfillment Summary Agent",
      "role": "Executive Fulfillment Summarizer",
      "responsibilities": "Synthesize final order decision (APPROVE, HOLD_FOR_REVIEW, or REJECT) and fulfillment dispatch brief.",
      "input_fields": [
        "record_id",
        "in_stock",
        "review_flag",
        "carrier_name",
        "service_level",
        "tax_jurisdiction",
        "tax_amount_usd",
        "invoice_tag"
      ],
      "output_fields": [
        "run_id",
        "record_id",
        "final_decision",
        "carrier_name",
        "service_level",
        "tax_jurisdiction",
        "tax_amount_usd",
        "invoice_tag",
        "summary",
        "human_review_required"
      ],
      "dependencies": [
        "invoice_tag_agent"
      ]
    }
  ],
  "baseline_execution_order": [
    "order_intake_agent",
    "inventory_check_agent",
    "fraud_screen_agent",
    "consolidated_carrier_routing_tax_classify",
    "invoice_tag_agent",
    "fulfillment_summary_agent"
  ],
  "optimizer_annotations": {
    "potential_parallel_branches": [
      [
        "inventory_check_agent",
        "fraud_screen_agent"
      ]
    ],
    "consolidation_candidates": [
      [
        "carrier_routing_agent",
        "tax_classify_agent",
        "invoice_tag_agent"
      ]
    ]
  },
  "handoff_projections": {
    "order_intake_agent->inventory_check_agent": {
      "candidate_id": "HANDOFF-ORDER_INTAKE_AGENT-TO-INVENTORY_CHECK_AGENT",
      "producer_agent": "order_intake_agent",
      "consumer_agent": "inventory_check_agent",
      "retained_fields": [
        "record_id",
        "shipping_region",
        "warehouse_region",
        "order_total_usd",
        "sku_items",
        "legacy_erp_dump",
        "deprecated_sku_notes"
      ],
      "excluded_fields": [
        "request_id",
        "customer_id",
        "customer_tier",
        "billing_country",
        "shipping_speed",
        "raw_audit_trail",
        "debug_headers",
        "internal_routing_flags",
        "formatting_metadata"
      ],
      "consumer_required_fields": [
        "record_id",
        "warehouse_region",
        "sku_items"
      ],
      "typed_delta_projection": true
    },
    "order_intake_agent->fraud_screen_agent": {
      "candidate_id": "HANDOFF-ORDER_INTAKE_AGENT-TO-FRAUD_SCREEN_AGENT",
      "producer_agent": "order_intake_agent",
      "consumer_agent": "fraud_screen_agent",
      "retained_fields": [
        "record_id",
        "customer_id",
        "customer_tier",
        "billing_country",
        "order_total_usd",
        "deprecated_sku_notes",
        "internal_routing_flags"
      ],
      "excluded_fields": [
        "request_id",
        "shipping_region",
        "warehouse_region",
        "shipping_speed",
        "sku_items",
        "legacy_erp_dump",
        "raw_audit_trail",
        "debug_headers",
        "formatting_metadata"
      ],
      "consumer_required_fields": [
        "record_id",
        "customer_id",
        "customer_tier",
        "billing_country",
        "order_total_usd"
      ],
      "typed_delta_projection": true
    }
  }
}